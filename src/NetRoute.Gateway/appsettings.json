{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NetRoute": {
    "ConfigFile": "netroute.routes.json",
    "DefaultRateLimitPolicy": "standard",
    "TrustForwardedHeaders": false,
    "RateLimit": {
      "Redis": {
        "ConnectionString": "",
        "CommandTimeoutMs": 50,
        "OnFailure": "LocalFallback",
        "BreakerCooldownSeconds": 5
      }
    },
    "Jwt": {
      "Authority": "",
      "Audience": "",
      "Issuer": ""
    }
  }
}
